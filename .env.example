# API server
PORT=8787
MEDIA_API_ORIGIN=http://localhost:5173
MEDIA_MAX_BYTES=524288000
VITE_MEDIA_API_URL=http://localhost:8787
# Optional MapLibre style JSON URL. The default is a public OpenFreeMap dark vector style.
# If this URL cannot be fetched, the frontend falls back to the OSM raster style.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Optional terrain-rgb / terrarium TileJSON. Set VITE_ENABLE_TERRAIN=false to disable it.
# VITE_TERRAIN_SOURCE_URL=https://tiles.mapterhorn.com/tilejson.json
# VITE_ENABLE_TERRAIN=true
MEDIA_ADMIN_TOKEN=

# Development defaults: local filesystem + JSON catalog
MEDIA_STORAGE_DRIVER=local
MEDIA_DATABASE_DRIVER=json
MEDIA_LOCAL_ROOT=./data/media
MEDIA_CATALOG_PATH=./data/media-catalog.json
MEDIA_LOCAL_PUBLIC_BASE_URL=http://localhost:8787/api/media/file

# Production alternative: Cloudflare R2 + Postgres
# MEDIA_STORAGE_DRIVER=r2
# MEDIA_DATABASE_DRIVER=postgres
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<server-only-access-key>
# R2_SECRET_ACCESS_KEY=<server-only-secret-key>
# R2_BUCKET=dog-map-media
# R2_PUBLIC_BASE_URL=https://media.example.com
# MEDIA_ADMIN_TOKEN=<long-random-server-only-token>
# DATABASE_URL=postgres://user:password@host:5432/database
